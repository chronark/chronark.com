---
import { getCollection } from "astro:content";
import * as stylex from "@stylexjs/stylex";
import Base from "../layouts/Base.astro";
import { link, typo } from "../styles/base.styles";
import { home, postLinkMarker } from "../styles/home.styles";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
---

<Base title="Andreas Thomas">
  <section>
    <p {...stylex.attrs(home.intro)}>
      I'm the CTO and co-founder of <a
        href="https://unkey.com"
        {...stylex.attrs(link.base, home.introLink)}>unkey.com</a
      >, the developer platform for modern APIs. Deploy APIs instantly, route
      traffic through global gateways, and understand usage in one place.
    </p>
  </section>

  <section {...stylex.attrs(home.writing)}>
    <h2 {...stylex.attrs(typo.monoLabel, home.monoLabel)}>Writing</h2>
    <ul {...stylex.attrs(home.posts)}>
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              data-astro-prefetch
              {...stylex.attrs(link.base, home.postLink, postLinkMarker)}
            >
              <span {...stylex.attrs(home.postTitle)}>{post.data.title}</span>
              <span {...stylex.attrs(home.postRule)} aria-hidden="true" />
              <time
                datetime={post.data.date.toISOString()}
                {...stylex.attrs(typo.monoDate)}
              >
                {formatDate(post.data.date)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
