---
import { getCollection, render } from "astro:content";
import * as stylex from "@stylexjs/stylex";
import { articleComponents } from "../../components/article/components";
import Base from "../../layouts/Base.astro";
import { link, typo } from "../../styles/base.styles";
import { post as postStyles } from "../../styles/post.styles";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogImage={`/og/${post.id}.png`}
>
  <nav {...stylex.attrs(postStyles.nav)}>
    <a href="/" {...stylex.attrs(link.base, typo.monoLabel, postStyles.navLink)}
      >← home</a
    >
  </nav>
  <header {...stylex.attrs(postStyles.articleHead)}>
    <h1 {...stylex.attrs(typo.h1, postStyles.h1)}>{post.data.title}</h1>
    <time datetime={post.data.date.toISOString()} {...stylex.attrs(typo.monoDate)}>
      {formatDate(post.data.date)}
    </time>
  </header>
  <article>
    <Content components={articleComponents} />
  </article>
</Base>
